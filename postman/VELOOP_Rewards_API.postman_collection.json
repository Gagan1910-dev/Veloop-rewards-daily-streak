{
  "info": {
    "_postman_id": "veloop-rewards-daily-streak-api-v1",
    "name": "VELoop Rewards — Daily Streak API",
    "description": "Comprehensive Postman API collection for the VELoop Rewards Daily Streak & Authentication system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check API health status and get server timestamp."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('authToken', json.data.token);",
                  "        console.log('authToken saved to collection variables.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gagan Chandra\",\n  \"email\": \"gagan.intern@velooprewards.in\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user account and auto-initialize their linked Wallet (zero balances)."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('authToken', json.data.token);",
                  "        console.log('authToken updated in collection variables.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gagan.intern@velooprewards.in\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user credentials and obtain signed JWT token."
          },
          "response": []
        },
        {
          "name": "Get Authenticated Profile (Me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Retrieve currently authenticated user profile and live wallet balance."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Daily Streak",
      "item": [
        {
          "name": "Get Daily Streak Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/daily-streak",
              "host": ["{{baseUrl}}"],
              "path": ["daily-streak"]
            },
            "description": "Fetch complete server-authoritative streak state, 7-day card statuses, and countdown timestamps."
          },
          "response": []
        },
        {
          "name": "Claim Daily Reward",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/daily-streak/claim",
              "host": ["{{baseUrl}}"],
              "path": ["daily-streak", "claim"]
            },
            "description": "Claim today's eligible daily reward. The body is intentionally empty as the backend is 100% authoritative."
          },
          "response": []
        },
        {
          "name": "Get Streak Check-In History",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/daily-streak/history",
              "host": ["{{baseUrl}}"],
              "path": ["daily-streak", "history"]
            },
            "description": "Fetch user check-in history and immutable reward transaction records."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Security & Negative Tests",
      "item": [
        {
          "name": "Unauthenticated Claim Attempt (401 Expected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/daily-streak/claim",
              "host": ["{{baseUrl}}"],
              "path": ["daily-streak", "claim"]
            },
            "description": "Attempting to claim without an Authorization header must return 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "Tampered Payload Injection (Ignored by Server)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": 7,\n  \"reward\": 1000000,\n  \"amount\": 999999,\n  \"currency\": \"USD\",\n  \"userId\": \"hacker_123\",\n  \"streak\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/daily-streak/claim",
              "host": ["{{baseUrl}}"],
              "path": ["daily-streak", "claim"]
            },
            "description": "Testing that injected day/amount/currency values are ignored; the server awards only the authentic current day reward."
          },
          "response": []
        },
        {
          "name": "Premature Cooldown Claim Attempt (400 Expected)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/daily-streak/claim",
              "host": ["{{baseUrl}}"],
              "path": ["daily-streak", "claim"]
            },
            "description": "Submitting a claim request during an active cooldown window must return 400 Bad Request with code COOLDOWN_ACTIVE."
          },
          "response": []
        }
      ]
    }
  ]
}
