# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas Cloud Connection)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/veloop_rewards?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

